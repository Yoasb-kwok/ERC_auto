# Detect controller type
def is_gamepad(joystick_name):
    """Detect if the controller is a gamepad (PS4, PS5, Xbox)"""
    if joystick_name is None:
        return False
    name_lower = joystick_name.lower()
    return any(keyword in name_lower for keyword in ['playstation', 'ps4', 'ps5', 'dualshock', 'dualsense', 'xbox', 'xinput'])

