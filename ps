def get_gamepad_inputs(joystick):
    """Get inputs from gamepad controller (PS4, PS5, Xbox)"""
    try:
        # Left joystick X-axis for steering
        steering_axis = joystick.get_axis(0)  # -1 (left) to 1 (right)
        
        # Get number of axes to determine controller type
        num_axes = joystick.get_numaxes()
        
        # R2 and L2 triggers - User confirmed mapping:
        # L2 = axis 4 (values: -1 released, 1 pressed)
        # R2 = axis 5 (values: -1 released, 1 pressed)
        l2_axis = 0
        r2_axis = 0
        
        # Read L2 from axis 4
        if num_axes > 4:
            try:
                l2_axis = joystick.get_axis(4)
            except:
                pass
        
        # Read R2 from axis 5
        if num_axes > 5:
            try:
                r2_axis = joystick.get_axis(5)
            except:
                pass
        
        # Debug: Log all axes if debug mode is on
        if DEBUG_MODE:
            log(f"L2 (axis 4): {l2_axis:.3f}, R2 (axis 5): {r2_axis:.3f}")
            all_axes = []
            for i in range(min(num_axes, 6)):
                try:
                    val = joystick.get_axis(i)
                    all_axes.append(f"Axis{i}={val:.3f}")
                except:
                    pass
            log(f"All axes: {', '.join(all_axes)}")
        
        # Normalize trigger values: -1 (released) -> 0, 1 (pressed) -> 1
        # Formula: (axis_value + 1) / 2
        # -1 -> (-1 + 1) / 2 = 0
        # 1 -> (1 + 1) / 2 = 1
        l2_value = (l2_axis + 1) / 2
        l2_value = max(0.0, min(1.0, l2_value))
        
        r2_value = (r2_axis + 1) / 2
        r2_value = max(0.0, min(1.0, r2_value))
        
        # Buttons: Try multiple mappings for L1/R1
        # PS4/PS5: L1 = button 4, R1 = button 5
        # Xbox: LB = button 4, RB = button 5
        # Some controllers: L1 = button 6, R1 = button 7
        num_buttons = joystick.get_numbuttons()
        l1_button = False
        r1_button = False
        
        # Try common button indices for L1 and R1 (check most common first)
        # Priority order based on controller type
        l1_candidates = [4, 6, 8, 10]  # Common L1/LB button indices
        r1_candidates = [5, 7, 9, 11]  # Common R1/RB button indices
        
        # Check for L1 button - try all candidates, use first match
        for btn_idx in l1_candidates:
            if num_buttons > btn_idx:
                try:
                    button_state = joystick.get_button(btn_idx)
                    if button_state:
                        l1_button = True
                        break
                except:
                    pass
        
        # Check for R1 button - try all candidates, use first match
        for btn_idx in r1_candidates:
            if num_buttons > btn_idx:
                try:
                    button_state = joystick.get_button(btn_idx)
                    if button_state:
                        r1_button = True
                        break
                except:
                    pass
        
        # Stop button (usually X/Square or A button)
        stop_button = False
        if num_buttons > 0:
            try:
                stop_button = joystick.get_button(0) or (joystick.get_button(1) if num_buttons > 1 else False)
            except:
                pass
        
        return steering_axis, l2_value, r2_value, l1_button, r1_button, stop_button
    except Exception as e:
        if DEBUG_MODE:
            log(f"Error reading gamepad: {e}")
        return 0, 0, 0, False, False, False

def get_steering_wheel_inputs(joystick):
    """Get inputs from steering wheel (G27)"""
    try:
        wheel_axis = joystick.get_axis(0)  # Steering: -1 (left) to 1 (right)
        accel_axis = joystick.get_axis(1)  # Accelerator
        brake_axis = joystick.get_axis(2)  # Brake
        stop_button = joystick.get_button(0)  # Stop button
        return wheel_axis, accel_axis, brake_axis, stop_button
    except pygame.error:
        log("Invalid axis. Check joystick configuration.")
        return 0, 1.0, 1.0, False

def toggle_debug():
    global DEBUG_MODE
    DEBUG_MODE = not DEBUG_MODE
    log(f"Debug mode: {'Enabled' if DEBUG_MODE else 'Disabled'}")

def update_loop():
    global last_left_speed, last_right_speed, last_stop_state, last_servo_angle, accel_pressed, brake_pressed
    try:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                on_close()

        # Initialize variables for UI display
        l2_value = 0.0
        r2_value = 0.0
        accel_value = 1.0
        brake_value = 1.0
        stop_button = False
        
        # Read inputs, handling no joystick case (simulation mode)
        if joystick is None:
            wheel_axis = 0.0
            accel_axis = 1.0  # Neutral/released
            brake_axis = 1.0  # Neutral/released
            left_speed = 0
            right_speed = 0
            stop_state = 0
            # In sim mode, don't update pressed flags to keep them False initially
        elif CONTROLLER_TYPE == "gamepad":
            # Read gamepad inputs
            steering_axis, l2_value, r2_value, _, _, _ = get_gamepad_inputs(joystick)
            
            # Update pressed flags
            if r2_value > 0.05:  # Threshold to detect press
                accel_pressed = True
            if l2_value > 0.05:
                brake_pressed = True
            
            # Debug: Log raw axis values
            if DEBUG_MODE:
                debug_msg = f"Raw inputs: steering={steering_axis:.3f}, L2={l2_value:.3f}, R2={r2_value:.3f}"
                log(debug_msg)
            
            # Simple logic: R2 = forward speed, L2 = backward speed
            # If both released (both <= 0.05), car stops
            # Forward speed: directly from R2 value (0-255)
            right_speed = int(r2_value * 255) if r2_value > 0.05 else 0
            
            # Backward speed: directly from L2 value (0-255)
            left_speed = int(l2_value * 255) if l2_value > 0.05 else 0
            
            # Stop state: 1 if both triggers are released, 0 otherwise
            stop_state = 1 if (r2_value <= 0.05 and l2_value <= 0.05) else 0
            
            # Update display values
            accel_value = r2_value
            brake_value = l2_value
            
            # Process steering from left joystick
            wheel_axis = steering_axis
            
        else:  # steering_wheel
            wheel_axis, accel_axis, brake_axis, stop_button = get_steering_wheel_inputs(joystick)
            
            # Update pressed flags (only if joystick present)
            if accel_axis != 0:
                accel_pressed = True
            if brake_axis != 0:
                brake_pressed = True
            
            # Process accelerator for forward speed
            accel_value = accel_axis if accel_pressed else 1.0  # Treat as released until pressed
            # Process brake for backward speed
            brake_value = brake_axis if brake_pressed else 1.0  # Treat as released until pressed
            
            # Debug: Log raw axis values and pressed flags
            if DEBUG_MODE:
                debug_msg = f"Raw inputs: wheel={wheel_axis:.3f}, accel={accel_axis:.3f}, brake={brake_axis:.3f}, "
                debug_msg += f"stop={stop_button}, accel_pressed={accel_pressed}, brake_pressed={brake_pressed}"
                log(debug_msg)
            
            # Process accelerator and brake
            if stop_button:
                left_speed = 0
                right_speed = 0
                stop_state = 1
            else:
                right_speed = int((1.0 - accel_value) * 127.5) if accel_value < 1.0 else 0  # Forward: 0 to 255
                left_speed = int((1.0 - brake_value) * 127.5) if brake_value < 1.0 else 0  # Backward: 0 to 255
                stop_state = 0

        # Process steering
        servo_angle = int(90 * (1 + wheel_axis))  # -1 (left) → 0°, 1 (right) → 180°
        servo_angle = max(50, min(180, servo_angle))

        # Constrain speeds
        left_speed = max(0, min(190, left_speed))  # Backward
        right_speed = max(0, min(190, right_speed))  # Forward

        # Determine direction for display
        direction = "Left" if wheel_axis < 0 else \
                    "Right" if wheel_axis > 0 else "Straight"

        # Apply force feedback (only if instance exists and not in sim mode)
        if logitech_steering_wheel_instance and joystick is not None and not stop_state:
            wheel_deviation = abs(wheel_axis) * 100
            logitech_steering_wheel_instance.play_spring_force(0, 0, SPRING_FORCE_SATURATION, int(wheel_deviation))
            speed = max(left_speed, right_speed)
            if speed > 0:
                logitech_steering_wheel_instance.play_constant_force(0, int(speed * 0.2))
        elif logitech_steering_wheel_instance and joystick is not None:
            logitech_steering_wheel_instance.stop_spring_force(0)
            logitech_steering_wheel_instance.stop_constant_force(0)

        # Update UI labels
        steering_label.config(text=f"Steering: {wheel_axis:.3f}")
        direction_label.config(text=f"Direction: {direction}")
        lspeed_label.config(text=f"Left Speed: {left_speed}")
        rspeed_label.config(text=f"Right Speed: {right_speed}")
        servo_label.config(text=f"Servo Angle: {servo_angle}°")
        
        if CONTROLLER_TYPE == "gamepad" and joystick is not None:
            # Gamepad-specific labels
            mode_label.config(text="Mode: Gamepad (R2=Forward, L2=Backward)")
            accel_label.config(text=f"R2 (Forward): {r2_value:.2f}")
            brake_label.config(text=f"L2 (Backward): {l2_value:.2f}")
            stop_label.config(text=f"Status: {'STOPPED' if stop_state == 1 else 'MOVING'}")
        else:
            # Steering wheel labels
            mode_label.config(text="Mode: Steering Wheel")
            accel_label.config(text=f"Accelerator: {'Pressed' if accel_value < 1.0 else 'Released'}")
            brake_label.config(text=f"Brake: {'Pressed' if brake_value < 1.0 else 'Released'}")
            stop_label.config(text=f"Stop: {'Pressed' if stop_button else 'Released'}")

        # Send command if state changes (even in sim mode, sends neutral commands)
        if (left_speed != last_left_speed or
            right_speed != last_right_speed or
            stop_state != last_stop_state or
            servo_angle != last_servo_angle):
            command = f"L:{left_speed},R:{right_speed},B:{stop_state},S:{servo_angle}\n"
            sock.sendto(command.encode(), (UDP_IP, UDP_PORT))
            if DEBUG_MODE: 
                log(f"Sent: {command.strip()}")   
            time.sleep(0.01)  # Small delay to ensure ESP8266 processes packet

        # Update states
        last_left_speed = left_speed
        last_right_speed = right_speed
        last_stop_state = stop_state
        last_servo_angle = servo_angle

        # Schedule next update
        root.after(int(CYCLE_TIME * 1000), update_loop)

    except Exception as e:
        log(f"Error: {e}")
        # Don't call on_close here to avoid recursion; just log

def on_close():
    global logitech_steering_wheel_instance
    log("Closing application")
    if logitech_steering_wheel_instance:
        logitech_steering_wheel_instance.stop_spring_force(0)
        logitech_steering_wheel_instance.stop_constant_force(0)
        logitech_steering_wheel_instance.shutdown()
    sock.close()
    pygame.quit()
    root.destroy()
    sys.exit()

# Now set button commands and protocol after functions are defined
debug_btn.config(command=lambda: toggle_debug())
quit_btn.config(command=on_close)
root.protocol("WM_DELETE_WINDOW", on_close)

# Start the update loop in the main thread
update_loop()

# Start Tkinter main loop
root.mainloop()
